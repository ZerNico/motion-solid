{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "lockFileMaintenance": { "enabled": true },
    "packageRules": [
        {
            "description": "Solid's packages move together (release candidates)",
            "groupName": "Solid",
            "matchPackageNames": ["solid-js", "@solidjs/**"]
        },
        {
            "description": "Bumping Motion means porting upstream's changes (see UPSTREAM.md): approve from the dashboard",
            "groupName": "Motion",
            "matchPackageNames": ["motion", "motion-dom", "motion-utils"],
            "dependencyDashboardApproval": true
        },
        {
            "groupName": "Vitest",
            "matchPackageNames": ["vitest", "@vitest/**"]
        },
        {
            "description": "Prettier 2 keeps the files copied from upstream byte-identical",
            "matchPackageNames": ["prettier"],
            "allowedVersions": "2.x"
        },
        {
            "description": "TypeScript 6 is the `typescript` package for tools that need its JS API (declarations); TypeScript 7 typechecks",
            "matchPackageNames": ["@typescript/typescript6"],
            "allowedVersions": "6.x"
        }
    ]
}
