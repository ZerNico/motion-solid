{
    "name": "motion-solid-monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "scripts": {
        "docs:dev": "pnpm --filter docs dev",
        "docs:build": "pnpm --filter docs build",
        "build": "pnpm --filter @motion-s/solid build",
        "check:package": "pnpm --filter @motion-s/solid check:package",
        "size": "size-limit",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "oxlint packages/motion-solid/src packages/motion-solid/test test",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "vitest",
        "test:upstream": "vitest --project motion-solid",
        "test:browser": "vitest --project motion-solid-browser",
        "test:browser:ui": "vitest --project motion-solid-browser --browser.headless=false",
        "test:browsers": "cross-env VITEST_BROWSER=all vitest --project motion-solid-browser"
    },
    "devDependencies": {
        "@size-limit/preset-small-lib": "^14.2.0",
        "@solidjs/testing-library": "1.0.0-beta.3",
        "@solidjs/vite-plugin": "3.0.0-next.50",
        "@solidjs/web": "2.0.0-rc.15",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@vitest/browser-playwright": "5.0.5",
        "cross-env": "10.1.0",
        "jsdom": "30.1.2",
        "oxfmt": "0.73.0",
        "oxlint": "^1.88.0",
        "pkg-pr-new": "^0.0.91",
        "playwright": "^1.64.1",
        "size-limit": "^14.2.0",
        "solid-js": "2.0.0-rc.15",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript7": "npm:typescript@7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24"
    }
}
