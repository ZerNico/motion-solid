{
    "name": "motion-solid-monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "scripts": {
        "dev": "pnpm --filter playground dev",
        "dev:react": "pnpm --filter playground-react dev",
        "build": "pnpm --filter @motion-s/solid build",
        "check:package": "pnpm --filter @motion-s/solid check:package",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "oxlint packages/motion-solid/src packages/motion-solid/test test playground/src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest",
        "test:upstream": "vitest --project motion-solid",
        "test:browser": "vitest --project motion-solid-browser",
        "test:browser:ui": "vitest --project motion-solid-browser --browser.headless=false",
        "test:browsers": "cross-env VITEST_BROWSER=all vitest --project motion-solid-browser"
    },
    "devDependencies": {
        "@solidjs/testing-library": "1.0.0-beta.3",
        "@solidjs/vite-plugin": "3.0.0-next.47",
        "@solidjs/web": "2.0.0-rc.13",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.4",
        "@vitest/browser-playwright": "5.0.3",
        "cross-env": "10.1.0",
        "jsdom": "^30.1.1",
        "oxlint": "^1.87.0",
        "playwright": "^1.63.0",
        "prettier": "2.8.8",
        "solid-js": "2.0.0-rc.13",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript7": "npm:typescript@7.0.2",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": ">=24"
    }
}
